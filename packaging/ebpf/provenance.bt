#!/usr/bin/env bpftrace
/*
 * OVERLORD eBPF flight recorder — EXPERIMENTAL, requires root.
 *
 * Kernel-side provenance capture for a wrapped process tree: records exec,
 * file mutation, and connect events for the given PID and its descendants.
 * This is the privileged upgrade over the strace-based --trace recorder
 * (lower overhead, unfakeable by the traced process).
 *
 * Usage: sudo bpftrace packaging/ebpf/provenance.bt <root_pid>
 * Output: one line per event; pipe to a file next to the session's
 *         provenance.jsonl.
 */

BEGIN { @watch[(uint64)$1] = 1; printf("overlord-ebpf: watching pid %d\n", $1); }

/* follow the process tree */
tracepoint:sched:sched_process_fork /@watch[args->parent_pid]/ {
  @watch[(uint64)args->child_pid] = 1;
}
tracepoint:sched:sched_process_exit /@watch[args->pid]/ {
  delete(@watch[args->pid]);
}

tracepoint:syscalls:sys_enter_execve /@watch[pid]/ {
  printf("%llu exec pid=%d %s\n", nsecs, pid, str(args->filename));
}
tracepoint:syscalls:sys_enter_openat /@watch[pid] && (args->flags & 0x3) != 0/ {
  /* O_WRONLY|O_RDWR */
  printf("%llu open-write pid=%d %s\n", nsecs, pid, str(args->filename));
}
tracepoint:syscalls:sys_enter_unlinkat /@watch[pid]/ {
  printf("%llu unlink pid=%d %s\n", nsecs, pid, str(args->pathname));
}
tracepoint:syscalls:sys_enter_renameat2 /@watch[pid]/ {
  printf("%llu rename pid=%d %s -> %s\n", nsecs, pid,
         str(args->oldname), str(args->newname));
}
tracepoint:syscalls:sys_enter_connect /@watch[pid]/ {
  printf("%llu connect pid=%d\n", nsecs, pid);
}

END { clear(@watch); }
